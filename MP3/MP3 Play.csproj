<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	 <AssemblyName>AUREON</AssemblyName>
	 <ApplicationIcon>AUREON.ico</ApplicationIcon>
	 <Product>AUREON</Product>
	 <Authors>CapitanSashko</Authors>
	 <Company>CapitanSashko company</Company>
	 <Copyright>© 2026 Oleksandr Echkenko. All rights reserved.</Copyright>
	 <Description>AUREON, music player with equalizer and playlists</Description>
	 <Version>1.0.0</Version>
	 <AssemblyVersion>1.0.0.0</AssemblyVersion>
	 <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AUREON.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
	
  </ItemGroup>

</Project>